// {{.Priv}}Column returns column name of field
func {{.Priv}}Column(f {{.Index}}) (string, error) {
	if int(f) < 0 || int(f) >= len({{.Priv}}Columns) || {{.Priv}}Columns[f] == "" {
		return "", fmt.Errorf("{{.Table}}: field %d is not a clickhouse column", int(f))
	}
	return {{.Priv}}Columns[f], nil
}

// {{.Priv}}Select returns select list of fields, all columns when empty
func {{.Priv}}Select(fields []{{.Index}}) (string, []{{.Index}}, error) {
	if len(fields) == 0 {
		return {{.Priv}}SelectAll, {{.Priv}}Fields, nil
	}
	list := make([]string, 0, len(fields))
	for _, f := range fields {
		col, err := {{.Priv}}Column(f)
		if err != nil {
			return "", nil, err
		}
		list = append(list, col)
	}
	return strings.Join(list, ", "), fields, nil
}

// {{.Priv}}Set returns "a = $1, b = $2" in stable order, placeholders from $start
func {{.Priv}}Set(v map[{{.Index}}]any, start int) (string, []any, error) {
	if len(v) == 0 {
		return "", nil, errors.New("{{.Table}}: no values")
	}
	list := make([]string, 0, len(v))
	args := make([]any, 0, len(v))
	for i, f := range slices.Sorted(maps.Keys(v)) {
		col, err := {{.Priv}}Column(f)
		if err != nil {
			return "", nil, err
		}
		list = append(list, col+" = $"+strconv.Itoa(start+i))
		args = append(args, v[f])
	}
	return strings.Join(list, ", "), args, nil
}

