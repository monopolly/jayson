// Stat returns count of rows by values of field: {"DE": 425, "US": 134}
func (a *{{.Class}}) Stat(field {{.Index}}) (map[string]int, error) {
	col, err := {{.Priv}}Column(field)
	if err != nil {
		return nil, err
	}
	rows, err := a.conn.Query(context.Background(), "select toString("+col+"), count() from {{.Table}} group by "+col)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	res := map[string]int{}
	for rows.Next() {
		var k string
		var n uint64
		if err = rows.Scan(&k, &n); err != nil {
			return nil, err
		}
		res[k] = int(n)
	}
	return res, rows.Err()
}

