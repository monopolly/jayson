// ResetSequence sets next {{.Inc.Name}} to max({{.Inc.Name}}) + add (1 by default).
// Useful after insert with own ids: InsertFull, Upsert, InsertMany
func (a *{{.Class}}) ResetSequence(add ...int64) error {
	plus := int64(1)
	if len(add) > 0 {
		plus = add[0]
	}
	_, err := a.db.Exec(context.Background(), "select setval(pg_get_serial_sequence('{{.Table}}', '{{.Inc.Name}}'), coalesce((select max({{.Inc.Name}}) from {{.Table}}), 0) + $1, false)", plus)
	return err
}

// SetSequence sets next {{.Inc.Name}}
func (a *{{.Class}}) SetSequence(v int64) error {
	_, err := a.db.Exec(context.Background(), "select setval(pg_get_serial_sequence('{{.Table}}', '{{.Inc.Name}}'), $1, false)", v)
	return err
}
