const {{.Priv}}CreateTable = `{{.CreateTable}}`

// indexes from tags: sql{index}, sql{idx="group"}, sql{search="group"}
var {{.Priv}}Indexes = []string{
{{- range .Indexes}}
	"{{.SQL}}",
{{- end}}
}

// CreateTable creates table if not exists
func (a *{{.Class}}) CreateTable() error {
	_, err := a.db.Exec(context.Background(), {{.Priv}}CreateTable)
	return err
}

// CreateIndexes creates indexes if not exist
func (a *{{.Class}}) CreateIndexes() error {
	for _, q := range {{.Priv}}Indexes {
		if _, err := a.db.Exec(context.Background(), q); err != nil {
			return err
		}
	}
	return nil
}

// Init creates table and indexes
func (a *{{.Class}}) Init() error {
	if err := a.CreateTable(); err != nil {
		return err
	}
	return a.CreateIndexes()
}
